# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=velvet
DATABASE_SCHEMA=velvet_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/velvet

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# API
PORT=4000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Abacate Pay
ABACATE_PAY_API_KEY=your_abacate_pay_api_key_here
ABACATE_PAY_MODE=development

# Brevo Email Service
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_SENDER=noreply@velvet.com
EMAIL_SENDER_NAME=Velvet
